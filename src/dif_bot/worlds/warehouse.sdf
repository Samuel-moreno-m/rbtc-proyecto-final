<?xml version="1.0" ?>
<!--
  Bodega simple 10 m x 8 m con estanterias y obstaculos.
  Origen del mundo = pose de aparicion del robot = origen del mapa SLAM.
-->
<sdf version="1.9">
  <world name="warehouse">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.8 0.8 0.85 1</background>
      <grid>false</grid>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ================= PAREDES EXTERIORES ================= -->
    <model name="walls">
      <static>true</static>
      <link name="link">
        <!-- Norte (y=+4) -->
        <collision name="c_n"><pose>0 4.1 0.5 0 0 0</pose><geometry><box><size>10.4 0.2 1.0</size></box></geometry></collision>
        <visual name="v_n"><pose>0 4.1 0.5 0 0 0</pose><geometry><box><size>10.4 0.2 1.0</size></box></geometry>
          <material><ambient>0.85 0.8 0.7 1</ambient><diffuse>0.85 0.8 0.7 1</diffuse></material></visual>
        <!-- Sur (y=-4) -->
        <collision name="c_s"><pose>0 -4.1 0.5 0 0 0</pose><geometry><box><size>10.4 0.2 1.0</size></box></geometry></collision>
        <visual name="v_s"><pose>0 -4.1 0.5 0 0 0</pose><geometry><box><size>10.4 0.2 1.0</size></box></geometry>
          <material><ambient>0.85 0.8 0.7 1</ambient><diffuse>0.85 0.8 0.7 1</diffuse></material></visual>
        <!-- Este (x=+5) -->
        <collision name="c_e"><pose>5.1 0 0.5 0 0 0</pose><geometry><box><size>0.2 8.4 1.0</size></box></geometry></collision>
        <visual name="v_e"><pose>5.1 0 0.5 0 0 0</pose><geometry><box><size>0.2 8.4 1.0</size></box></geometry>
          <material><ambient>0.85 0.8 0.7 1</ambient><diffuse>0.85 0.8 0.7 1</diffuse></material></visual>
        <!-- Oeste (x=-5) -->
        <collision name="c_w"><pose>-5.1 0 0.5 0 0 0</pose><geometry><box><size>0.2 8.4 1.0</size></box></geometry></collision>
        <visual name="v_w"><pose>-5.1 0 0.5 0 0 0</pose><geometry><box><size>0.2 8.4 1.0</size></box></geometry>
          <material><ambient>0.85 0.8 0.7 1</ambient><diffuse>0.85 0.8 0.7 1</diffuse></material></visual>
        <!-- Tabique interior oeste (x=-1.5, de y=2.2 a y=4) -->
        <collision name="c_p"><pose>-1.5 3.1 0.5 0 0 0</pose><geometry><box><size>0.15 1.8 1.0</size></box></geometry></collision>
        <visual name="v_p"><pose>-1.5 3.1 0.5 0 0 0</pose><geometry><box><size>0.15 1.8 1.0</size></box></geometry>
          <material><ambient>0.85 0.8 0.7 1</ambient><diffuse>0.85 0.8 0.7 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ================= ESTANTERIAS ================= -->
    <model name="shelf_north">
      <static>true</static>
      <pose>1.5 2.0 0.6 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>2.0 0.5 1.2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>2.0 0.5 1.2</size></box></geometry>
          <material><ambient>0.9 0.5 0.1 1</ambient><diffuse>0.9 0.5 0.1 1</diffuse></material></visual>
      </link>
    </model>
    <model name="shelf_south">
      <static>true</static>
      <pose>1.5 -2.0 0.6 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>2.0 0.5 1.2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>2.0 0.5 1.2</size></box></geometry>
          <material><ambient>0.9 0.5 0.1 1</ambient><diffuse>0.9 0.5 0.1 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ================= OBSTACULOS ================= -->
    <model name="box_1">
      <static>true</static>
      <pose>-2.8 1.2 0.3 0 0 0.4</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.6 0.6 0.6</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.6 0.6 0.6</size></box></geometry>
          <material><ambient>0.55 0.35 0.2 1</ambient><diffuse>0.55 0.35 0.2 1</diffuse></material></visual>
      </link>
    </model>
    <model name="box_2">
      <static>true</static>
      <pose>3.6 -1.0 0.3 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.5 0.8 0.6</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.5 0.8 0.6</size></box></geometry>
          <material><ambient>0.55 0.35 0.2 1</ambient><diffuse>0.55 0.35 0.2 1</diffuse></material></visual>
      </link>
    </model>
    <model name="pillar">
      <static>true</static>
      <pose>-2.2 -1.6 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.35</radius><length>1.0</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.35</radius><length>1.0</length></cylinder></geometry>
          <material><ambient>0.3 0.6 0.3 1</ambient><diffuse>0.3 0.6 0.3 1</diffuse></material></visual>
      </link>
    </model>
    <model name="barrel">
      <static>true</static>
      <pose>-4.0 -3.0 0.4 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.25</radius><length>0.8</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.25</radius><length>0.8</length></cylinder></geometry>
          <material><ambient>0.2 0.4 0.8 1</ambient><diffuse>0.2 0.4 0.8 1</diffuse></material></visual>
      </link>
    </model>
  </world>
</sdf>
